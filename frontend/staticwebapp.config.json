{
  "routes": [
    {
      "route": "/home",
      "allowedRoles": ["authenticated"],
      "redirect": "/",
      "statusCode": 302
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/login",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.{svg,png,jpg,jpeg,gif,webp}", "*.{css,scss}", "*.js"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  }
}
